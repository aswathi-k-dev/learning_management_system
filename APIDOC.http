# ----- Token Generation -----

# api call for token generation 
###
POST http://127.0.0.1:8000/accounts/token/ 
Content-Type: application/json

{
    "username":"Abhinav",
    "password":"abhinav@123"
}

# ----- api call for profile completion ------
###
PUT http://127.0.0.1:8000/accounts/profile/complete/ 
Content-Type: application/json
Authorization: Token 7776e2f6f9a1fea165ec5a49a17c96131fafe7d8

{
    "qualification":"MSc Computer Science",
    "experience":5,
    "skills":"Python,Django,Machine Learning,SQL"
}

#------ course crud ------- 

# api call for list courses
###
GET http://127.0.0.1:8000/courses/list/ 
Accept: application/json
Authorization: Token 7776e2f6f9a1fea165ec5a49a17c96131fafe7d8

# api call for create 
###
POST http://127.0.0.1:8000/courses/create/ 
Content-Type: application/json 
Authorization: Token 7776e2f6f9a1fea165ec5a49a17c96131fafe7d8

{
    "title": "Java Full Stack Development",
    "description": "Learn Core Java, Advanced Java, Spring Boot, HTML, CSS and React.",
    "language": "Java",
    "fee": "30000.00",
    "duration": "6 Months",
    "category": "Full Stack"
}

#api call for retrieve 
###
GET http://127.0.0.1:8000/courses/retrieve/1
Accept: application/json
Authorization: Token 7776e2f6f9a1fea165ec5a49a17c96131fafe7d8

# api call for update 
PUT http://127.0.0.1:8000/courses/update/1/ 
Content-Type: application/json
Authorization: Token 7776e2f6f9a1fea165ec5a49a17c96131fafe7d8

# api call for delete
###
DELETE  http://127.0.0.1:8000/courses/delete/5/ 
